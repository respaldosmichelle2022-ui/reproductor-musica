# Copia este archivo a .env y reemplaza los valores con tus credenciales
PORT=8080

# Musica en Backblaze B2 (bucket PRIVADO). Si lo dejas vacio se usa tu carpeta local.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=

# Spotify
SPOTIFY_CLIENT_ID=TU_CLIENT_ID_SPOTIFY
SPOTIFY_CLIENT_SECRET=TU_CLIENT_SECRET_SPOTIFY
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# YouTube
YOUTUBE_API_KEY=TU_API_KEY_YOUTUBE
